<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Keystore 密钥不随备份迁移，密文也不能恢复到其他设备。 -->
    <cloud-backup>
        <exclude domain="sharedpref" path="krill_monitor_secret.xml"/>
        <exclude domain="sharedpref" path="krill_monitor_key_vault.xml"/>
        <exclude domain="sharedpref" path="krill_monitor_secret.xml.bak"/>
        <exclude domain="sharedpref" path="krill_monitor_key_vault.xml.bak"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="krill_monitor_secret.xml"/>
        <exclude domain="sharedpref" path="krill_monitor_key_vault.xml"/>
        <exclude domain="sharedpref" path="krill_monitor_secret.xml.bak"/>
        <exclude domain="sharedpref" path="krill_monitor_key_vault.xml.bak"/>
    </device-transfer>
</data-extraction-rules>
